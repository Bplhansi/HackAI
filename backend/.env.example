# --- AI (Person 2) ---
NEBIUS_API_KEY=your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Supabase (Person 3) ---
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here

# --- Backend settings ---
# true = everyone shares one demo user (no login). Set false once Supabase Auth is wired up.
DEMO_MODE=true
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
# How many days between repeat reminders, and the maximum number of them
REPEAT_EVERY_DAYS=3
MAX_REPEAT_REMINDERS=5
# Comma-separated list of frontend URLs allowed to call this backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://localhost:3000
# Set true to use ai_stub.py instead of the real AI (development only)
USE_STUB_AI=false